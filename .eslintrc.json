{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "indent": ["error", 4],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-var": "warn",
    "prefer-const": "warn",
    "no-implicit-globals": "warn"
  },
  "globals": {
    "$": "readonly",
    "jQuery": "readonly",
    "layer": "readonly",
    "artTemplate": "readonly"
  }
}
